{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "Agent Overview",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "Pod Restarts (last 1h)",
      "datasource": {"type": "prometheus", "uid": "$DS_PROMETHEUS"},
      "targets": [
        {"expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\", pod=~\"$pod\"}[1h]))", "legendFormat": "{{pod}}"}
      ],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1}
    },
    {
      "type": "timeseries",
      "title": "Pod CPU (cores)",
      "datasource": {"type": "prometheus", "uid": "$DS_PROMETHEUS"},
      "fieldConfig": {"defaults": {"unit": "cores"}},
      "targets": [
        {"expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", image!=\"\", pod=~\"$pod\"}[5m]))", "legendFormat": "{{pod}}"}
      ],
      "gridPos": {"h": 8, "w": 9, "x": 6, "y": 1}
    },
    {
      "type": "timeseries",
      "title": "Pod Memory (bytes)",
      "datasource": {"type": "prometheus", "uid": "$DS_PROMETHEUS"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "targets": [
        {"expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\", image!=\"\", pod=~\"$pod\"})", "legendFormat": "{{pod}}"}
      ],
      "gridPos": {"h": 8, "w": 9, "x": 15, "y": 1}
    },
    {
      "type": "row",
      "title": "Istio Ingress",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9}
    },
    {
      "type": "timeseries",
      "title": "Istio Requests/s (ingress)",
      "datasource": {"type": "prometheus", "uid": "$DS_PROMETHEUS"},
      "targets": [
        {
          "expr": "sum( rate(istio_requests_total{reporter=\"source\",source_workload=\"istio-ingressgateway\",source_workload_namespace=\"istio-system\"}[1m]) )",
          "legendFormat": "total"
        },
        {
          "expr": "sum by (destination_service) ( rate(istio_requests_total{reporter=\"source\",source_workload=\"istio-ingressgateway\",source_workload_namespace=\"istio-system\"}[1m]) )",
          "legendFormat": "{{destination_service}}"
        }
      ],
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 10}
    },
    {
      "type": "timeseries",
      "title": "Istio HTTP Latency P95 (s, ingress)",
      "datasource": {"type": "prometheus", "uid": "$DS_PROMETHEUS"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) ( rate(istio_request_duration_milliseconds_bucket{reporter=\"source\",source_workload=\"istio-ingressgateway\",source_workload_namespace=\"istio-system\"}[1m]) ) ) / 1000", "legendFormat": "p95"}
      ],
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 10}
    },
    {
      "type": "row",
      "title": "Cluster Node Health",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 17}
    },
    {
      "type": "timeseries",
      "title": "Node CPU usage (%)",
      "datasource": {"type": "prometheus", "uid": "$DS_PROMETHEUS"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "targets": [
        {"expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\\\"idle\\\"}[5m]))", "legendFormat": "{{instance}}"}
      ],
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 18}
    },
    {
      "type": "timeseries",
      "title": "Node Memory usage (%)",
      "datasource": {"type": "prometheus", "uid": "$DS_PROMETHEUS"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "targets": [
        {"expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "{{instance}}"}
      ],
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 18}
    },
    {
      "type": "timeseries",
      "title": "Node CPU total (cores)",
      "datasource": {"type": "prometheus", "uid": "$DS_PROMETHEUS"},
      "fieldConfig": {"defaults": {"unit": "cores"}},
      "targets": [
        {"expr": "sum by (node) (rate(node_cpu_seconds_total{mode!=\"idle\"}[5m]))", "legendFormat": "{{node}}"}
      ],
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 18}
    },
    {"type": "row", "title": "Requests and Latency (App)", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 25}},
    {
      "type": "timeseries",
      "title": "Mesh Requests/s (by workload)",
      "datasource": {"type": "prometheus", "uid": "$DS_PROMETHEUS"},
      "targets": [
        {
          "expr": "sum by (destination_workload, destination_workload_namespace) ( rate(istio_requests_total{reporter=\"destination\"}[1m]) )",
          "legendFormat": "{{destination_workload}} ({{destination_workload_namespace}})"
        }
      ],
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 26}
    },
    {
      "type": "timeseries",
      "title": "Mesh HTTP Latency P95 (by workload)",
      "datasource": {"type": "prometheus", "uid": "$DS_PROMETHEUS"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, destination_workload, destination_workload_namespace) ( rate(istio_request_duration_milliseconds_bucket{reporter=\"destination\"}[1m]) ) ) / 1000",
          "legendFormat": "p95 {{destination_workload}} ({{destination_workload_namespace}})"
        }
      ],
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 26}
    },
    {
      "type": "stat",
      "title": "CrashLooping Containers",
      "datasource": {"type": "prometheus", "uid": "$DS_PROMETHEUS"},
      "targets": [
        {"expr": "sum(kube_pod_container_status_waiting_reason{namespace=\"$namespace\", reason=\"CrashLoopBackOff\"})", "legendFormat": "CrashLoopBackOff"}
      ],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 33}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["istio", "ingress", "kubernetes"],
  "templating": {
    "list": [
      {"type": "datasource", "name": "DS_PROMETHEUS", "query": "prometheus", "current": {"text": "Prometheus", "value": "Prometheus"}},
      {"type": "query", "name": "namespace", "label": "Namespace", "datasource": {"type": "prometheus", "uid": "$DS_PROMETHEUS"}, "refresh": 2, "query": "label_values(kube_pod_info, namespace)", "current": {"text": "default", "value": "default", "selected": true}},
      {"type": "query", "name": "pod", "label": "Pod", "datasource": {"type": "prometheus", "uid": "$DS_PROMETHEUS"}, "refresh": 2, "query": "label_values(kube_pod_info{namespace=\"$namespace\"}, pod)", "current": {"text": "All", "value": ".*"}, "includeAll": true, "multi": true}
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {"refresh_intervals": ["5s", "10s", "15s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]},
  "timezone": "",
  "title": "Istio Observability",
  "uid": "istio-obsv",
  "version": 1,
  "weekStart": ""
}


